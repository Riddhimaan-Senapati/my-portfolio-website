# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers it.

# Required. Powers the site assistant.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional. Without it the GitHub stats card falls back to the unauthenticated
# 60-requests/hour limit, and the contribution graph is omitted entirely
# (GitHub only exposes the calendar via GraphQL, which requires a token).
# Scope needed: read:user
GITHUB_TOKEN=""

# Optional. Stores chat transcripts. The assistant works without it.
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Use the pooler URL (port 6543), not the direct connection.
#
# Setting up a fresh project (including after Supabase pauses or deletes a stale
# free-tier one): set this, then run `npm run db:migrate && npm run db:check`.
# `db:push` does the same from the schema directly, but prompts for confirmation
# and so needs a real terminal.
DATABASE_URL=""
